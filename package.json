{
  "name": "type-dash",
  "version": "1.0.0",
  "description": "A multiplayer typing test game",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon app.js",
    "start": "node app.js",
    "client:install": "npm --prefix client ci",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm run client:install && npm run client:build",
    "test": "npm --prefix client test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anisharma07/TypeDash.git"
  },
  "author": "Anirudh Sharma",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/anisharma07/TypeDash/issues"
  },
  "homepage": "https://github.com/anisharma07/TypeDash#readme",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.19.2",
    "mongodb": "^6.0.0",
    "mongoose": "^7.5.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
